{
  "folders": [
    {
      "name": "Tradinglabs",
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Trading stats - install dependencies",
        "type": "shell",
        "command": "python -m pip install -r requirements.txt",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Trading stats - run",
        "type": "shell",
        "command": "python -m streamlit run app.py --server.address 127.0.0.1",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Research desk - install dependencies",
        "type": "shell",
        "command": "pnpm install --frozen-lockfile",
        "options": {
          "cwd": "${workspaceFolder}/research-desk"
        },
        "problemMatcher": []
      },
      {
        "label": "Research desk - build",
        "type": "shell",
        "command": "pnpm build",
        "options": {
          "cwd": "${workspaceFolder}/research-desk"
        },
        "problemMatcher": []
      },
      {
        "label": "Research desk - develop",
        "type": "shell",
        "command": "pnpm dev",
        "options": {
          "cwd": "${workspaceFolder}/research-desk"
        },
        "problemMatcher": []
      }
    ]
  }
}
